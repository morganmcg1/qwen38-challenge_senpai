+                if (armDepth == 0) != (shipDepth == 0) { draftingSetDiffers += 1 }
+                if armDepth == 1 || armDepth == 2, shipDepth > armDepth {
+                    shallowerThanShip += 1
+                }
+            }
+        }
+        #expect(draftingSetDiffers == 0)
+        #expect(shallowerThanShip == 0)
+    }
+
+    // The behaviour the ranked curve predicts: at the ranked cap the arm is
+    // bimodal on 3 and 7 and never selects 4, 5 or 6, because the group
+    // transition makes those depths a local maximum of modelled cost per
+    // token. This is the histogram direction rung 3 measures.
+    @Test("the ranked-shaped walk is bimodal on depths 3 and 7")
+    func rankedWalkIsBimodal() {
+        let ranked = Qwen36MTPBlockSession.makeRankedTierDepthPrice()
