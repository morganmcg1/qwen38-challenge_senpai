+    @Test("the ranked-shaped arm holds hard guards 1 and 2 at every input")
+    func rankedArmHoldsTheHardGuards() {
+        let ranked = Qwen36MTPBlockSession.makeRankedTierDepthPrice()
+        let ship = Qwen36MTPBlockSession.makeUniformDepthPrice()
+        var draftingSetDiffers = 0
+        var shallowerThanShip = 0
+        for cap in 1 ... 7 {
