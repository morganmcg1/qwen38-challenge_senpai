+    /// ranked anchor, measured against the same rounds that produced the tier
+    /// factors. Rescaling this curve to `maxDepth * headStepCostRatio` would
+    /// replace the one quantity the ranked board actually reports with the
+    /// number it is meant to correct. Shape and level are one fit.
+    internal static func makeRankedTierDepthPrice() -> DepthPrice {
+        var marginal = [Double](repeating: rankedTierHeadStep,
+                                count: Qwen36MTPLimits.maxDepth)
+        for index in 0 ..< marginal.count {
+            let enteringWidth = index + 2
+            if enteringWidth == quantizedGroupWidth + 1 {
+                marginal[index] = rankedTierHeadStep * rankedGroupStepFactor
+            } else if enteringWidth > quantizedGroupWidth + 1 {
+                marginal[index] = rankedTierHeadStep * rankedTierFactor
+            }
+        }
