+    /// The acceptance estimate for one draft position, before anything is
+    /// proposed: the per-position EMA, tightened at the first two positions by
+    /// the pending primary's target top-2 margin.
+    private func positionAcceptEstimate(_ depth: Int) -> Double {
+        var p = positionAcceptEMA[depth]
+        if depth == 0, let tail = pendingTop2, tail.1.count >= 2 {
+            let margin = tail.1[0] - tail.1[1]
+            let conf = 1.0 / (1.0 + exp(-margin / 2.0))
+            p = Swift.min(p, conf)
+        } else if depth == 1, let tail = pendingTop2, tail.1.count >= 2 {
+            let margin = tail.1[0] - tail.1[1]
+            let conf2 = 1.0 / (1.0 + exp(-margin / 3.0))
+            p = Swift.min(p, conf2)
+        }
+        return p
+    }
+
+    /// Global minimum of modelled cost per token over the whole legal depth
+    /// range. The greedy walk stops at the FIRST depth where extending does
+    /// not pay, which is correct only when cost per token has one local
+    /// minimum. A group-transition step breaks that: the step into verify
+    /// width 5 makes depth 4 a local maximum, so the greedy walk can stop at
+    /// depth 3 and never see that depth 7 is cheaper, or stop AT depth 4 when
+    /// the reach is high enough to clear the small width-4 step. This walk
+    /// scores every depth and takes the best one. It reads exactly the same
+    /// inputs as the greedy walk and never changes which tokens are emitted.
+    private func argminDepth(cap: Int, price: DepthPrice) -> Int {
+        var reach = 1.0
+        var expected = 0.0
+        var bestDepth = 0
+        var bestCost = price.cumulative[0]
+        for depth in 0 ..< cap {
+            let p = positionAcceptEstimate(depth)
+            reach *= p
+            expected += reach
+            let cost = price.cumulative[depth + 1] / (1.0 + expected)
+            if Self.traceRounds {
+                scheduleTrace += String(
+                    format: "%d:%.6f/%.6f/%.6f;", depth, p, reach, cost)
+            }
+            if cost < bestCost {
+                bestCost = cost
+                bestDepth = depth + 1
+            }
+        }
+        return bestDepth
+    }
