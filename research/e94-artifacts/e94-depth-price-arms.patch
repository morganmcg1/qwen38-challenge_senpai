+    // E94. The E92 arm holds the shipped level like every other arm, and it
+    // carries the group-transition cliff at the step into verify width 5.
+    @Test("the E92 arm holds the total and puts its cliff at width 5")
+    func e92ArmHoldsTheTotalAndCliffsAtWidthFive() {
+        let price = Qwen36MTPBlockSession.makeDepthPrice(
+            rescaling: Qwen36MTPBlockSession.measuredRawDepthPriceE92)
+        #expect(price.marginal.count == maxDepth)
+        #expect(abs(price.marginal.reduce(0, +) - Double(maxDepth) * h) < 1e-12)
+        let cliff = price.marginal[3]
+        for depth in 0 ..< maxDepth where depth != 3 && depth != 7 {
+            #expect(cliff > 2.0 * price.marginal[depth])
+        }
+    }
+
+    // E94, the theorem `snap4` implements, in the form that needs no price
+    // array at all. A depth-4 round beats a depth-3 round only when
+    // `C(w5)/C(w4) < Y(4)/Y(3)`. With `a_i` the probability of reaching
+    // position `i`, `Y(3) = 1 + a1 + a2 + a3` and `Y(4) - Y(3) = a4`. Reach is
+    // non-increasing, so `a1 >= a2 >= a3 >= a4` and
+    //
+    //     Y(4)/Y(3) = 1 + a4 / (1 + a1 + a2 + a3)
+    //              <= 1 + a4 / (1 + 3 * a4)  <=  1.25
+    //
+    // attained only as `q -> 1`. E92 measured `C(w5)/C(w4) = 1.4623`, which is
+    // 17.0 % above that ceiling, so depth 4 is dominated unconditionally.
+    //
+    // Two measured numbers and one combinatorial inequality. No rescaling, no
+    // `pure`-versus-`hadd` choice, no acceptance estimate.
+    @Test("depth 4 is dominated for every acceptance profile that can exist")
+    func depthFourIsAlwaysDominated() {
+        // E92 rung 2 production sweep, median round GPU-busy microseconds.
+        let cW4 = 86_237.4
+        let cW5 = 126_103.1
+        let yieldCeiling = 1.25
+        #expect(cW5 / cW4 > yieldCeiling)
+
+        // The ceiling is tight: no non-increasing reach sequence beats it.
+        for step in 1 ... 100 {
+            let q = Double(step) / 100.0
+            var a = 1.0
+            var y3 = 1.0
+            for _ in 0 ..< 3 {
+                a *= q
+                y3 += a
+            }
+            let a4 = a * q
+            #expect((y3 + a4) / y3 <= yieldCeiling)
+            #expect(cW5 / cW4 > (y3 + a4) / y3)
+        }
+    }
+
+    // The same theorem expressed through the rescaled price array, which is
+    // what the `amine92` arm actually reads. `m4 / C3 > 1/4` is the condition,
+    // because `1 + m4/C3` is the modelled cost ratio and 1.25 is the yield
+    // ceiling. NOTE: the near-zero coefficient `C3 - 3 * m4 = -0.009` is NOT
+    // the decision margin. It sits near zero for a reason unrelated to the
+    // decision; the margin is `m4 / C3` against `1/4`, which is 34.3 %
+    // against 25 %.
+    @Test("the rescaled E92 price also dominates depth 4, with a real margin")
+    func rescaledPriceAlsoDominatesDepthFour() {
+        let price = Qwen36MTPBlockSession.makeDepthPrice(
+            rescaling: Qwen36MTPBlockSession.measuredRawDepthPriceE92)
+        let m4 = price.marginal[3]
+        let c3 = price.cumulative[3]
+        #expect(m4 / c3 > 0.25)
+        #expect(abs(m4 / c3 - 0.335783) < 1e-5)
+
+        for step in 1 ... 100 {
+            let p = Double(step) / 100.0
+            var reach = 1.0
+            var expected = 0.0
+            var best = 0
+            var bestCost = price.cumulative[0]
+            for depth in 0 ..< maxDepth {
+                reach *= p
+                expected += reach
+                let cost = price.cumulative[depth + 1] / (1.0 + expected)
+                if cost < bestCost {
+                    bestCost = cost
+                    best = depth + 1
+                }
+            }
+            #expect(best != 4)
+        }
+    }
