+    /// E128 rung-1 instrument, research only, never on a timed leg.
+    ///
+    /// The shipped schedule is adaptive, so acceptance at position j is only
+    /// ever observed on rounds the estimator already believed would reach j.
+    /// Every acceptance vector read from a shipped trace is therefore survivor
+    /// biased upward at depth. Pinning the depth removes the selection and
+    /// exposes every position on every round, which is the uncensored
+    /// measurement a counterfactual depth policy has to be priced on.
+    ///
+    /// `DARKBLOOM_` is one of the six prefixes `sanitizedRuntimeWorkerEnvironment`
+    /// forwards, so this gate survives into a runtime-worker leg. An
+    /// `MLXFAST_`-spelled gate is dropped and would silently do nothing
+    /// (harness defect 28).
+    private static let e128ForcedDepth: Int? = {
+        guard let raw = ProcessInfo.processInfo
+            .environment["DARKBLOOM_E128_FORCE_DEPTH"],
+            let value = Int(raw) else { return nil }
+        return value
+    }()
+
+    /// Keeps the forced arm inside the caps the shipped policy already
+    /// respects, so the arm cannot reach a verify width the campaign has not
+    /// proven exact. Only the estimator is removed, never the width envelope.
+    private func e128ClampedForcedDepth(offeredDepth: Int, forced: Int) -> Int {
+        Swift.max(0, Swift.min(
+            Swift.min(offeredDepth, Qwen36MTPLimits.maxDepth),
+            Swift.min(Self.segmentedVerifyDepthCap, forced)))
+    }
